{
  "name": "app-foundry",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "app-foundry",
      "version": "0.0.0",
      "workspaces": [
        "packages/js/*"
      ]
    },
    "node_modules/@app-foundry/cli": {
      "resolved": "packages/js/cli",
      "link": true
    },
    "node_modules/@app-foundry/core": {
      "resolved": "packages/js/core",
      "link": true
    },
    "node_modules/@app-foundry/debug": {
      "resolved": "packages/js/debug",
      "link": true
    },
    "node_modules/@app-foundry/feedback": {
      "resolved": "packages/js/feedback",
      "link": true
    },
    "node_modules/@app-foundry/media": {
      "resolved": "packages/js/media",
      "link": true
    },
    "node_modules/@app-foundry/storage-s3": {
      "resolved": "packages/js/storage-s3",
      "link": true
    },
    "packages/js/cli": {
      "name": "@app-foundry/cli",
      "version": "0.0.0",
      "bin": {
        "app-foundry": "src/cli.js"
      }
    },
    "packages/js/core": {
      "name": "@app-foundry/core",
      "version": "0.0.0"
    },
    "packages/js/debug": {
      "name": "@app-foundry/debug",
      "version": "0.0.0",
      "dependencies": {
        "@app-foundry/core": "0.0.0"
      }
    },
    "packages/js/feedback": {
      "name": "@app-foundry/feedback",
      "version": "0.0.0",
      "dependencies": {
        "@app-foundry/core": "0.0.0",
        "@app-foundry/debug": "0.0.0",
        "@app-foundry/media": "0.0.0"
      }
    },
    "packages/js/media": {
      "name": "@app-foundry/media",
      "version": "0.0.0",
      "dependencies": {
        "@app-foundry/core": "0.0.0"
      }
    },
    "packages/js/storage-s3": {
      "name": "@app-foundry/storage-s3",
      "version": "0.0.0",
      "dependencies": {
        "@app-foundry/core": "0.0.0",
        "@app-foundry/media": "0.0.0"
      }
    }
  }
}
